# ==========================================================
# BCA SmartLearn AI - Server Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials.
# ==========================================================

# --- Runtime ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave blank during development to use the built-in in-memory database fallback.
MONGODB_URI=
MONGODB_DB_NAME=bca-smartlearn-ai
# When MONGODB_URI is empty/unreachable, boot a local in-memory MongoDB (dev only).
ENABLE_DEV_DB_FALLBACK=true

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=
# Leave blank for localhost. Set to your API domain (e.g. .smartlearn.com) in production.
COOKIE_DOMAIN=

# --- AI (Google Gemini) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=45000

# --- Code execution (Judge0 CE) ---
# RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_MS=20000

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_MINUTES=720

# --- Email (verification / password reset) ---
# Leave SMTP_HOST blank in development: emails are written to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BCA SmartLearn AI <no-reply@bcasmartlearn.local>"

# --- Super Admin bootstrap (used only by `npm run create-admin`) ---
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
