{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix bca-smartlearn-ai/client && npm install --prefix bca-smartlearn-ai/server --omit=dev",
  "buildCommand": "npm run build --prefix bca-smartlearn-ai/client",
  "outputDirectory": "bca-smartlearn-ai/client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/:path*"
        }
      ]
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
